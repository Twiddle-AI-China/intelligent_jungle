     return app
 
 
+async def _serve(config: EngineConfig) -> None:
+    """明文口 + 可选 HTTPS 口,同一个 app 两个 site。
+
+    为什么要 HTTPS:``AudioWorklet`` 只在 secure context 里存在,而
+    ``http://<局域网IP>:<port>/`` 不是 secure context。这种情况下 WS 照样能连上、
+    ready 帧照收,但客户端 ``ensureWorklet()`` 一失败就 ``degrade()`` 到本地兜底
+    合成器 —— 现象是「后端连不上」,实际网络一切正常,极难排查。所以别把这个口
+    当可选优化,它是局域网直连唯一可用的入口。
+
+    明文口保留:SSH 隧道到 localhost、容器健康检查、tools/ 下的自测脚本都在用它,
+    而 localhost 本身就是 secure context,不需要 TLS。
+    """
+    runner = web.AppRunner(build_app(config), handle_signals=True)
+    await runner.setup()
+
+    await web.TCPSite(runner, config.host, config.port).start()
+    if config.tls_enabled:
+        import ssl
+
+        ssl_context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+        ssl_context.load_cert_chain(config.tls_cert, config.tls_key)
+        await web.TCPSite(runner, config.host, config.tls_port, ssl_context=ssl_context).start()
+        print(f"[boot] HTTPS(局域网直连走这个)→ https://{config.host}:{config.tls_port}/", flush=True)
+    else:
+        print(
+            "[boot] 未配 --tls-cert/--tls-key:只有明文口。"
+            "局域网裸 IP 访问会因为不是 secure context 而拿不到 AudioWorklet,"
+            "客户端将静默退回本地合成。",
+            flush=True,
+        )
+
+    try:
+        await asyncio.Event().wait()      # 交给信号处理器结束
+    finally:
+        await runner.cleanup()
+
+
 def main(argv: list[str] | None = None) -> None:
     config = config_from_args(argv)
-    app = build_app(config)
     print(
         f"[boot] flock-voice-engine → http://{config.host}:{config.port}"
         f"  (pool={config.pool_size}, {config.sample_rate} Hz, "
         f"{config.block_samples} samples/块 = {config.block_seconds * 1000:.1f} ms)",
         flush=True,
     )
-    web.run_app(app, host=config.host, port=config.port, print=None)
+    try:
+        asyncio.run(_serve(config))
+    except (KeyboardInterrupt, web.GracefulExit):
+        # handle_signals=True 下 SIGTERM/SIGINT 走 GracefulExit;容器 stop 就是这条路。
+        pass
 
 
