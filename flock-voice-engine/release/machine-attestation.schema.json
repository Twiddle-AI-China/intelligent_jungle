{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 5 machine attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "machineIdSha256",
    "sshHostKeySha256",
    "canonicalInterfaceAddresses",
    "gpuUuids",
    "platform",
    "rawEvidence",
    "environmentEvidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "hostname": {
      "type": "string"
    },
    "machineIdSha256": {
      "$ref": "#/$defs/hex"
    },
    "sshHostKeySha256": {
      "type": "string",
      "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
    },
    "canonicalInterfaceAddresses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "gpuUuids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^GPU-[A-Za-z0-9-]+$"
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "gpuModel",
        "driverVersion",
        "torchVersion",
        "cudaVersion",
        "cudaAvailable",
        "availableMemoryBytes"
      ],
      "properties": {
        "architecture": { "const": "aarch64" },
        "gpuModel": { "type": "string", "minLength": 1 },
        "driverVersion": { "type": "string", "minLength": 1 },
        "torchVersion": { "type": "string", "minLength": 1 },
        "cudaVersion": { "type": "string", "minLength": 1 },
        "cudaAvailable": { "const": true },
        "availableMemoryBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "rawEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machineId",
        "sshHostKey",
        "interfaces",
        "gpus"
      ],
      "properties": {
        "machineId": {
          "$ref": "#/$defs/hex"
        },
        "sshHostKey": {
          "$ref": "#/$defs/hex"
        },
        "interfaces": {
          "$ref": "#/$defs/hex"
        },
        "gpus": {
          "$ref": "#/$defs/hex"
        }
      }
    },
    "environmentEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cudaDriver",
        "torch",
        "availableMemory",
        "architecture",
        "vllmNormalProfile",
        "vllmBurstProfile"
      ],
      "properties": {
        "cudaDriver": {
          "$ref": "#/$defs/hex"
        },
        "torch": {
          "$ref": "#/$defs/hex"
        },
        "availableMemory": {
          "$ref": "#/$defs/hex"
        },
        "architecture": {
          "$ref": "#/$defs/hex"
        },
        "vllmNormalProfile": {
          "$ref": "#/$defs/hex"
        },
        "vllmBurstProfile": {
          "$ref": "#/$defs/hex"
        }
      }
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
